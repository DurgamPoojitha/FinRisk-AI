# FinRisk AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://finrisk:finrisk_secure_123@localhost:5432/finrisk
# For local development without Docker, use SQLite fallback:
# DATABASE_URL=sqlite:///./finrisk.db

# ─── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Security ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_DO_NOT_USE_THIS_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_HOURS=24

# ─── LLM Providers ──────────────────────────────────────────
# Options: mock | gemini | openai
LLM_PROVIDER=mock

# Required only if LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ─── Risk Engine Configuration ───────────────────────────────
# Annual risk-free rate (decimal). 0.04 = 4%
DEFAULT_RISK_FREE_RATE=0.04

# ─── Application Settings ───────────────────────────────────
# Set to false in production
DEBUG=true

# App name displayed in API responses and logs
APP_NAME=FinRisk AI

# ─── Frontend ───────────────────────────────────────────────
# URL for the Streamlit frontend to call the backend
BACKEND_API_URL=http://localhost:8000/api

# ─── PostgreSQL (Docker Compose) ────────────────────────────
POSTGRES_PASSWORD=finrisk_secure_123
